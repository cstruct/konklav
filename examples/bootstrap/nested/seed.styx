// A hand-written seed: a tenant tree, its roles and members, and an
// operator. Records without ids are found by their natural keys, so this
// file can be applied again without creating anything twice.
id_namespace 3f1c9a52-6a1e-4d0b-9a0e-6c1d8f0b2e11
catalog_file "../catalog.json"

templates ({
    key reader
    description "Reads projects"
    metadata {label Reader, shown_to (members admins)}
    policies ({action project:read})
})

global_roles ({key support, policies ({action konklav:subject:impersonate})})

tenants ({
    key acme
    facts {seats 25}
    templates (reader)
    roles ({key editor, metadata {label Editor}, policies ({action document:write, scope_bound true})})
    children ({key acme-north})
    members (
        {
            email ada@acme.example
            password_hash "$argon2id$v=19$m=65536,t=3,p=4$8+FttqUgBxV0WJVJEoSFig$sTbjdRtZ6f7ZyvBNPA+oh9ju0QJs7jIKIFEyit//6T0"
            roles (reader)
            scoped_roles ({role editor, scope_kind project, scope_id p-1})
            facts {member_type professional}
        }
        {
            email bo@acme.example
            email_link true
            roles (reader)
        }
    )
})

subjects ({
    email ops@konklav.example
    password_hash "$argon2id$v=19$m=65536,t=3,p=4$8+FttqUgBxV0WJVJEoSFig$sTbjdRtZ6f7ZyvBNPA+oh9ju0QJs7jIKIFEyit//6T0"
    global_roles (konklav.admin support)
})
