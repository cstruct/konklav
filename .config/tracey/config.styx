specs (
    {
        name konklav
        include (
            docs/spec/**/*.md
        )
        impls (
            {
                name rust
                include (
                    items/**/*.rs
                )
                exclude (
                    target/**
                )
            }
            {
                name python
                include (
                    items/py-control-plane/**/*.py
                )
                exclude (
                    items/py-control-plane/.venv/**
                )
            }
        )
    }
)
