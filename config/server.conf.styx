control_plane {
    host "127.0.0.1"
    port 8080
}

subject {
    host "127.0.0.1"
    port 8081
}

relying {
    host "127.0.0.1"
    port 8082
}

bootstrap {
    subject "root-operator"
    display_name "Bootstrap root operator"
}

jwt {
    issuer "http://127.0.0.1:8082"
    default_audience "conclave-dev"
    ttl_seconds 900
}

feldera {
    enabled false
    base_url "http://127.0.0.1:8080"
    pipeline_prefix "conclave"
    readiness_probe true
    compile_profile "dev"
    auto_start false
    start_initial "paused"
}
