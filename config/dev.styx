listen {
    subject "127.0.0.1:8080"
    relying "127.0.0.1:8081"
    control "127.0.0.1:8082"
}

database {
    host localhost
    port 55432
    name conclave
    user conclave
    max_connections 10
}

log {
    filter "info,conclave_server=debug"
}

tokens {
    issuer "http://127.0.0.1:8080"
    audience conclave-dev
    signing_key_file "config/dev.signing-key.pem"
}

browser {
    allowed_origins ("http://localhost:5173")
    secure_cookies false
}
