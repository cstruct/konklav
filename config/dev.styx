listen {
    subject "127.0.0.1:8080"
    relying "127.0.0.1:8081"
    control "127.0.0.1:8082"
}

database {
    host localhost
    port 15432
    name konklav
    user konklav
    max_connections 10
}

// Logs, and exporting traces, metrics and logs over OTLP (off by default).
// With an OpenTelemetry Collector on localhost, set `otlp.endpoint` to
// "http://localhost:4318" and enable a signal, as in `traces {enabled true}`.
telemetry {
    service_name konklav-dev
    logs {level "info,konklav_server=debug"}
}

tokens {
    issuer "http://127.0.0.1:8080"
    audience konklav-dev
    signing_key_file "config/dev.signing-key.pem"
    // Where clients address Konklav in DPoP proofs: the issuer, the
    // control plane's own listener (as the CLI reaches it, with
    // `konklav login --control-url http://127.0.0.1:8082`), and each
    // console origin with and without its /control prefix.
    dpop_urls (
        "http://127.0.0.1:8080"
        "http://127.0.0.1:8082"
        "http://localhost:5173" "http://localhost:5173/control"
        "http://127.0.0.1:8083" "http://127.0.0.1:8083/control"
        "http://localhost:8083" "http://localhost:8083/control"
        "http://localhost:5174" "http://localhost:5174/control"
    )
}

// Origins whose pages may use browser sign-in with the refresh cookie. The
// console (`mise run console:serve`) serves on port 8083 and proxies /v1
// and /control/v1 here, so Konklav sees requests from that origin.
// The login page's development server (`mise run login:dev`) is on 5174.
browser {
    allowed_origins ("http://localhost:5173" "http://127.0.0.1:8083" "http://localhost:8083" "http://localhost:5174")
    secure_cookies false
}

// WebAuthn does not accept IP addresses, so open the console at
// http://localhost:8083 to use passkeys.
passkeys {
    rp_id localhost
    rp_name "Konklav (dev)"
    origins ("http://localhost:8083" "http://localhost:5173")
}

// Konklav as an OpenID provider, with its built-in login page at
// http://127.0.0.1:8080/login/ as the login URL. `mise run dev:signing-key`
// creates the untracked ID-token key. Passkeys aren't offered there, since
// WebAuthn doesn't accept the issuer's IP address.
oidc_provider {
    id_token_key_file "config/dev.id-token-key.pem"
}

login_page {
    enabled true
    title "Konklav (dev)"
}

// Anyone signed in may ask to join any tenant from the login page; decide
// at /v1/access-requests on the control plane.
access_requests {
    all_tenants true
}
