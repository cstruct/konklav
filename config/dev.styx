listen {
    subject "127.0.0.1:8080"
    relying "127.0.0.1:8081"
    control "127.0.0.1:8082"
}

database {
    host localhost
    port 55432
    name konklav
    user konklav
    max_connections 10
}

log {
    filter "info,konklav_server=debug"
}

tokens {
    issuer "http://127.0.0.1:8080"
    audience konklav-dev
    signing_key_file "config/dev.signing-key.pem"
}

// Origins whose pages may use browser sign-in with the refresh cookie. The
// console (`mise run console:serve`) serves on 127.0.0.1:8083 and proxies
// /v1 and /control/v1 here, so Conclave sees requests from that origin.
browser {
    allowed_origins ("http://localhost:5173" "http://127.0.0.1:8083")
    secure_cookies false
}
