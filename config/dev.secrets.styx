// Development-only credentials for the Postgres started by `mise run db:up`.
database {
    password konklav
}

control {
    bootstrap_token konklav-dev-control-token
}

// Development-only key for encrypting TOTP seeds.
mfa {
    totp_keys ({id dev, key "ZGV2LW9ubHktdG90cC1lbmNyeXB0aW9uLWtleS0zMmI="})
}
