catalog {
    actions (
        {name tenant:user:read, description "Read tenant user records"}
        {name tenant:user:write, description "Write tenant user records"}
        {name tenant:clinic:read, description "Read clinic-scoped records"}
        {name sys:audit:read, description "Read operator-facing audit data"}
    )
}

templates (
    {
        tenant root,
        key doctor,
        policies (
            {effect allow, action tenant:user:read}
            {effect allow, action tenant:clinic:read, scope_kind clinic}
        )
    }
    {
        tenant tenant-a
        key doctor
        source {
            tenant root
            key doctor
            mode tracking
        }
        policies (
            {effect allow, action tenant:user:write}
        )
    }
)

roles (
    {
        tenant tenant-a
        key doctor
        template doctor
    }
)
