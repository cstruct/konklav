{
  "openapi": "3.1.0",
  "info": {
    "title": "Konklav control plane",
    "description": "The Konklav server: subject-facing, relying and control-plane HTTP surfaces",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "1.3.0"
  },
  "paths": {
    "/v1/memberships/{id}": {
      "get": {
        "tags": [
          "memberships"
        ],
        "operationId": "get_membership",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MembershipId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MembershipDetail"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "memberships"
        ],
        "summary": "`PUT /v1/memberships/{id}`: idempotent on the id.",
        "operationId": "create_membership",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chosen by the caller",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MembershipId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMembership"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Already existed with the same content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Membership"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Membership"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memberships/{id}/end": {
      "post": {
        "tags": [
          "memberships"
        ],
        "summary": "`POST /v1/memberships/{id}/end`: ends the membership and the sessions\ntargeting it.",
        "operationId": "end_membership",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MembershipId"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Membership"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/memberships/{id}/facts": {
      "put": {
        "tags": [
          "memberships"
        ],
        "operationId": "set_membership_facts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/MembershipId"
            }
          }
        ],
        "requestBody": {
          "description": "The membership's new facts",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Membership"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants": {
      "get": {
        "tags": [
          "tenants"
        ],
        "summary": "`GET /v1/tenants?parent=&before=&limit=`",
        "operationId": "list_tenants",
        "parameters": [
          {
            "name": "parent",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/TenantId"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TenantPage"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{id}": {
      "get": {
        "tags": [
          "tenants"
        ],
        "operationId": "get_tenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The tenant: a UUID or `root`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tenant"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "tenants"
        ],
        "summary": "`PUT /v1/tenants/{id}`: idempotent on the id.",
        "operationId": "create_tenant",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chosen by the caller",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/TenantId"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTenant"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Already existed with the same content",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Tenant"
                }
              }
            }
          },
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Tenant"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{id}/facts": {
      "put": {
        "tags": [
          "tenants"
        ],
        "operationId": "set_tenant_facts",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The tenant: a UUID or `root`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "description": "The tenant's new facts",
          "content": {
            "application/json": {
              "schema": {
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Tenant"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{id}/memberships": {
      "get": {
        "tags": [
          "memberships"
        ],
        "summary": "`GET /v1/tenants/{id}/memberships?active=`",
        "operationId": "list_memberships",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The tenant: a UUID or `root`",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "active",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Membership"
                  }
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/tenants/{id}/state": {
      "put": {
        "tags": [
          "tenants"
        ],
        "summary": "`PUT /v1/tenants/{id}/state`: leaving `active` ends every session\ntargeting the tenant.",
        "operationId": "set_tenant_state",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "The tenant: a UUID or `root`",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetTenantState"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Written_Tenant"
                }
              }
            }
          },
          "default": {
            "description": "An error; branch on `error.code`",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssignmentTarget": {
        "oneOf": [
          {
            "type": "object",
            "description": "A tenant role, for a membership in the role's tenant.",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/MembershipId",
                "description": "A tenant role, for a membership in the role's tenant."
              },
              "type": {
                "type": "string",
                "enum": [
                  "membership"
                ]
              }
            }
          },
          {
            "type": "object",
            "description": "A global role, for a subject directly.",
            "required": [
              "id",
              "type"
            ],
            "properties": {
              "id": {
                "$ref": "#/components/schemas/SubjectId",
                "description": "A global role, for a subject directly."
              },
              "type": {
                "type": "string",
                "enum": [
                  "subject"
                ]
              }
            }
          }
        ],
        "description": "Who a role is assigned to."
      },
      "CreateMembership": {
        "type": "object",
        "required": [
          "subject",
          "tenant"
        ],
        "properties": {
          "facts": {
            "type": "object"
          },
          "subject": {
            "$ref": "#/components/schemas/SubjectId"
          },
          "tenant": {
            "type": "string",
            "description": "The tenant (a UUID or `root`)."
          }
        }
      },
      "CreateTenant": {
        "type": "object",
        "properties": {
          "facts": {
            "type": "object"
          },
          "parent": {
            "type": [
              "string",
              "null"
            ],
            "description": "The parent tenant (a UUID or `root`); `root` when absent."
          },
          "templates": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Templates to instantiate roles from, atomically with the tenant."
          }
        }
      },
      "Cursor": {
        "type": "integer",
        "format": "int64",
        "description": "The position of an event in the change feed.\n\nCursors increase strictly with every event but may have gaps, so they are\nonly meaningful for ordering and resuming, never for counting."
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorCode": {
        "type": "string",
        "description": "Stable, machine-readable error codes. Never rename a variant: add a new\none instead.",
        "enum": [
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "INVALID_REQUEST",
          "CONFLICT",
          "UNAUTHENTICATED",
          "INVALID_CREDENTIALS",
          "SESSION_ENDED",
          "FORBIDDEN",
          "RATE_LIMITED",
          "OVERLOADED",
          "SIGNING_KEY_UNAVAILABLE",
          "CLAIMS_HOOK_UNAVAILABLE",
          "INTERNAL",
          "DATABASE_UNAVAILABLE",
          "MIGRATIONS_PENDING"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        }
      },
      "Membership": {
        "type": "object",
        "required": [
          "id",
          "subject_id",
          "tenant_id",
          "state",
          "facts",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "facts": {
            "type": "object"
          },
          "id": {
            "$ref": "#/components/schemas/MembershipId"
          },
          "managed_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "The identity provider whose claim mapping created it, if any."
          },
          "state": {
            "$ref": "#/components/schemas/MembershipState"
          },
          "subject_id": {
            "$ref": "#/components/schemas/SubjectId"
          },
          "tenant_id": {
            "$ref": "#/components/schemas/TenantId"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "MembershipDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Membership"
          },
          {
            "type": "object",
            "required": [
              "assignments"
            ],
            "properties": {
              "assignments": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/RoleAssignment"
                }
              }
            }
          }
        ]
      },
      "MembershipId": {
        "type": "string",
        "format": "uuid",
        "description": "Identifies a membership of one subject in one tenant."
      },
      "MembershipState": {
        "type": "string",
        "enum": [
          "active",
          "ended"
        ]
      },
      "RoleAssignment": {
        "type": "object",
        "required": [
          "id",
          "role_id",
          "target",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "managed_by": {
            "type": [
              "string",
              "null"
            ],
            "description": "The identity provider whose claim mapping created it, if any."
          },
          "role_id": {
            "type": "string",
            "format": "uuid"
          },
          "scope": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Scope"
              },
              {
                "type": "null"
              }
            ]
          },
          "target": {
            "$ref": "#/components/schemas/AssignmentTarget"
          }
        }
      },
      "Scope": {
        "type": "object",
        "description": "A resource inside a tenant. Konklav treats the id as opaque.",
        "required": [
          "kind",
          "id"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          }
        }
      },
      "SetTenantState": {
        "type": "object",
        "required": [
          "state"
        ],
        "properties": {
          "state": {
            "$ref": "#/components/schemas/TenantState"
          }
        }
      },
      "SubjectId": {
        "type": "string",
        "format": "uuid",
        "description": "Identifies a subject for its whole lifetime."
      },
      "Tenant": {
        "type": "object",
        "required": [
          "id",
          "state",
          "facts",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "facts": {
            "type": "object"
          },
          "id": {
            "$ref": "#/components/schemas/TenantId"
          },
          "parent_id": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TenantId"
              },
              {
                "type": "null"
              }
            ]
          },
          "state": {
            "$ref": "#/components/schemas/TenantState"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "TenantId": {
        "type": "string",
        "format": "uuid",
        "description": "Identifies a tenant. Callers may supply their own UUID v7 values when\ncreating tenants."
      },
      "TenantPage": {
        "type": "object",
        "required": [
          "tenants"
        ],
        "properties": {
          "next": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TenantId"
              },
              {
                "type": "null"
              }
            ]
          },
          "tenants": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tenant"
            }
          }
        }
      },
      "TenantState": {
        "type": "string",
        "enum": [
          "active",
          "suspended",
          "deleted"
        ]
      },
      "Written_Membership": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "id",
              "subject_id",
              "tenant_id",
              "state",
              "facts",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "facts": {
                "type": "object"
              },
              "id": {
                "$ref": "#/components/schemas/MembershipId"
              },
              "managed_by": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The identity provider whose claim mapping created it, if any."
              },
              "state": {
                "$ref": "#/components/schemas/MembershipState"
              },
              "subject_id": {
                "$ref": "#/components/schemas/SubjectId"
              },
              "tenant_id": {
                "$ref": "#/components/schemas/TenantId"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "cursor": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Cursor"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        ],
        "description": "A write's result and the cursor of the last event it produced, if any."
      },
      "Written_Tenant": {
        "allOf": [
          {
            "type": "object",
            "required": [
              "id",
              "state",
              "facts",
              "created_at",
              "updated_at"
            ],
            "properties": {
              "created_at": {
                "type": "string",
                "format": "date-time"
              },
              "facts": {
                "type": "object"
              },
              "id": {
                "$ref": "#/components/schemas/TenantId"
              },
              "parent_id": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/TenantId"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "state": {
                "$ref": "#/components/schemas/TenantState"
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          {
            "type": "object",
            "properties": {
              "cursor": {
                "oneOf": [
                  {
                    "$ref": "#/components/schemas/Cursor"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        ],
        "description": "A write's result and the cursor of the last event it produced, if any."
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  },
  "security": [
    {
      "bearer": []
    }
  ]
}
