class Core:
    def __init__(self, config: str) -> None: ...
    def decide(self, token: str, requirements: str, now: int) -> str: ...
    def verify(self, token: str, now: int) -> str: ...
    def entitlements(self, subject: str, tenant: str | None, now: int) -> str: ...
    def is_trusted(self, now: int) -> bool: ...
    def feed_cursor(self) -> int | None: ...
    def on_jwks(self, jwks: str, now: int) -> None: ...
    def on_session(self, state: str) -> None: ...
    def on_session_unknown(self, session: str) -> None: ...
    def on_entitlements(self, set: str, now: int) -> None: ...
    def on_registered_scope(self, record: str, now: int) -> None: ...
    def on_registered_scope_unknown(self, kind: str, id: str, now: int) -> None: ...
    def on_fetch_failed(self, need: str) -> None: ...
    def on_feed_connected(self, now: int) -> None: ...
    def on_feed_activity(self, now: int) -> None: ...
    def on_feed_lost(self) -> None: ...
    def on_feed_event(self, event: str, now: int) -> None: ...
    def await_cursor(self, cursor: int) -> bool: ...
    def poll_work(self, now: int) -> str: ...
